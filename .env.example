# Insurance Agent Account Expansion Analyzer - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Close CRM Configuration
# =============================================================================
# Get your API key from Close CRM Settings > API Keys
CLOSE_API_KEY=api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override the base URL (default: https://api.close.com/api/v1)
# CLOSE_BASE_URL=https://api.close.com/api/v1

# Optional: Request timeout in seconds (default: 30)
# CLOSE_TIMEOUT_SECONDS=30

# =============================================================================
# Google Sheets Configuration
# =============================================================================
# Path to your Google service account credentials JSON file
GOOGLE_SHEETS_CREDENTIALS_PATH=/path/to/service-account.json

# Google Sheet ID from the spreadsheet URL
# (e.g., from https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
BENCHMARK_SHEET_ID=1abc123xyz_your_sheet_id_here

# =============================================================================
# Analysis Configuration
# =============================================================================
# Minimum confidence threshold (0-1) to include opportunities (default: 0.5)
MIN_CONFIDENCE_THRESHOLD=0.5

# Minimum number of similar agents required for projections (default: 10)
MIN_SIMILAR_AGENTS=10

# Maximum opportunities to return per agent (default: 5)
MAX_OPPORTUNITIES_PER_AGENT=5

# =============================================================================
# Performance Configuration
# =============================================================================
# Maximum concurrent API requests (default: 5)
MAX_CONCURRENT_REQUESTS=5

# Rate limit for Close CRM API (requests/second, default: 9, max: 10)
RATE_LIMIT_PER_SECOND=9

# Maximum API retry attempts (default: 3)
MAX_RETRIES=3

# =============================================================================
# Cache Configuration
# =============================================================================
# Agent data cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Benchmark data cache TTL in seconds (default: 3600 = 1 hour)
BENCHMARK_CACHE_TTL_SECONDS=3600

# Maximum entries in agent cache (default: 1000)
MAX_AGENT_CACHE_ENTRIES=1000

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format: json or text (default: json)
LOG_FORMAT=json
